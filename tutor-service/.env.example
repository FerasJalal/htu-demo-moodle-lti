OPENAI_API_KEY=sk-...
# Must exactly match block_criterio's identitysecret config in Moodle.
IDENTITY_SECRET=change-me
# Must exactly match rennix-lti's LTI_BRIDGE_SECRET.
LTI_BRIDGE_SECRET=change-me
# Must exactly match rennix-lti's TENANT_ADMIN_SECRET. Gates /admin/tenant-settings.
TENANT_ADMIN_SECRET=change-me-too
# Base URL of rennix-lti. Used to push quick-check grades to the LMS gradebook
# (POST /ags/score) for LTI-launched sessions. Leave unset to disable grade push.
RENNIX_LTI_URL=https://lti.rennix.ai
